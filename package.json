{
  "name": "livebuddy",
  "productName": "LiveBuddy",
  "version": "0.1.0",
  "description": "直播小助手：托盘常驻的柔光悬浮菜单、提示画布、标注、鼠标特效",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "start": "node scripts/build.mjs && electron .",
    "selftest": "node scripts/build.mjs && electron . --selftest",
    "dist": "node scripts/build.mjs --prod && electron-builder --win portable"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "45.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "dev.livebuddy.app",
    "files": ["dist/**", "package.json"],
    "asar": true,
    "electronLanguages": ["zh-CN", "en-US"],
    "win": { "target": "portable" }
  }
}
